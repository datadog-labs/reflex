# Copy to .env.local and load it into your shell. The CLI does not load dotenv files automatically.
# Never commit .env.local or credentials.
DD_API_KEY=
# Needed only for --datadog-evidence; use an application key with timeseries_query permission.
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=reflex
DD_ENV=local
# Needed for --policy jev, including --datadog-evidence.
TYPESAFE_API_KEY=
