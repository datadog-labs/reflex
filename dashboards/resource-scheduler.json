    {
      "id": 34,
      "definition": {
        "type": "group",
        "title": "Jev and Reflex \u2014 application scope",
        "layout_type": "ordered",
        "show_title": true,
        "background_color": "blue",
        "widgets": [
          {
            "id": 29,
            "definition": {
              "type": "note",
              "content": "This section ignores the run and policy filters. Reflex evaluations/transitions are scoped to the resource scheduler, but TypeSafe latency and token usage include **all workloads** in this application. Reflex transitions include clock/arrival events; they are not placement counts. No dollar cost is inferred from tokens.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false
            }
          },
          {
            "id": 30,
            "definition": {
              "type": "timeseries",
              "title": "Scheduler evaluations per bucket",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
